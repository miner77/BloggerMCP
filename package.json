{
  "name": "blogger-mcp",
  "version": "0.2.0",
  "description": "MCP server for Blogger drafts, pages, posts, comments, pageviews, project devlogs, and Strava running retrospectives.",
  "type": "module",
  "bin": {
    "blogger-mcp": "dist/server.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/server.ts",
    "oauth:google": "tsx src/auth/googleOAuthCallbackServer.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.0",
    "axios": "^1.7.9",
    "dotenv": "^16.4.7",
    "googleapis": "^144.0.0",
    "marked": "^15.0.6",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "optionalDependencies": {
    "sharp": "^0.33.5"
  },
  "engines": {
    "node": ">=20"
  }
}
