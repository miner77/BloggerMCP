GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth2callback
BLOGGER_BLOG_ID=

# Optional local token storage. Defaults to .tokens inside this project.
TOKEN_DIR=.tokens

# Optional image publishing support for local images.
# If set, local images are copied here and URLs are generated with BLOGGER_IMAGE_PUBLIC_BASE_URL.
BLOGGER_IMAGE_ASSET_DIR=public/blogger-assets
BLOGGER_IMAGE_PUBLIC_BASE_URL=https://example.com/blogger-assets

# Optional GitHub raw/public image URL support.
GITHUB_RAW_BASE_URL=

STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:3000/strava/callback
